  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*",
            "text/csv",
            ".csv",
            "application/json",
            ".json"
          ]
        }
      ]
    }
