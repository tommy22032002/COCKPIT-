<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="COCKPIT · PEA" android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/w_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="↻" android:textColor="@color/muted" android:textSize="16sp" android:paddingStart="10dp"/>
    </LinearLayout>
    <TextView android:id="@+id/w_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="—" android:textColor="@color/ink" android:textSize="26sp" android:textStyle="bold" android:maxLines="1"/>
    <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/gain" android:textSize="13sp" android:maxLines="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_gain" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:textSize="11sp" android:maxLines="1"/>
        <TextView android:id="@+id/w_at" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:textSize="10sp" android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp">
        <TextView android:id="@+id/w_p0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="1 mois" android:textColor="@color/ink" android:textSize="12sp" android:background="@drawable/chip_off"/>
        <TextView android:id="@+id/w_p1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="3 mois" android:textColor="@color/ink" android:textSize="12sp" android:background="@drawable/chip_off"/>
        <TextView android:id="@+id/w_p2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="1 an" android:textColor="@color/ink" android:textSize="12sp" android:background="@drawable/chip_off"/>
        <TextView android:id="@+id/w_p3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="Tout" android:textColor="@color/ink" android:textSize="12sp" android:background="@drawable/chip_off"/>
    </LinearLayout>
    <TextView android:id="@+id/w_per" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp"
        android:textColor="@color/muted" android:textSize="11sp" android:maxLines="1"/>
    <ImageView android:id="@+id/w_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:minHeight="70dp" android:layout_marginTop="4dp" android:scaleType="fitXY" android:contentDescription="Évolution du PEA"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Apport immobilier" android:textColor="@color/muted" android:textSize="11sp"/>
            <TextView android:id="@+id/w_ap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/w_ap_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:max="100" android:progressDrawable="@drawable/bar"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Objectif 100 000 €" android:textColor="@color/muted" android:textSize="11sp"/>
            <TextView android:id="@+id/w_ms" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="11sp" android:maxLines="1"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/w_ms_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:max="100" android:progressDrawable="@drawable/bar"/>
    </LinearLayout>
    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="@color/accent" android:textSize="12sp" android:maxLines="2"/>
    <TextView android:id="@+id/w_alert" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:textColor="#F0B45A" android:textSize="11sp" android:maxLines="2" android:visibility="gone"/>
</LinearLayout>
